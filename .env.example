# ==============================================================================
# ZENVITRA PLATFORM — ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & HOSTING URLS
# ------------------------------------------------------------------------------
AUTH_TRUST_HOST=true
NODE_ENV="production"
NEXT_PUBLIC_APP_NAME="Zenvitra Foundation"
NEXT_PUBLIC_SITE_URL="https://zenvitra.xyz"

# ------------------------------------------------------------------------------
# 2. CORE DATABASE & AUTH SECRETS
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate_a_secure_random_base64_string"
NEXTAUTH_SECRET="generate_a_secure_random_base64_string"

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ------------------------------------------------------------------------------
# 4. OAUTH PROVIDERS
# ------------------------------------------------------------------------------
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 5. CASHFREE PAYMENT GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
# Environment Toggle: "sandbox" for test mode, "production" for live payments
CASHFREE_ENVIRONMENT="sandbox"
NEXT_PUBLIC_CASHFREE_ENVIRONMENT="sandbox"

# Cashfree API Credentials
# Sandbox credentials start with TEST...
# Production credentials start with PROD... (from merchant.cashfree.com)
CASHFREE_APP_ID="your_cashfree_app_id_here"
CASHFREE_SECRET_KEY="your_cashfree_secret_key_here"

# Webhook Endpoint (auto-configured in backend):
# https://zenvitra.xyz/api/payments/cashfree/webhook
